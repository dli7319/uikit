{
  "name": "@david18284/uikit",
  "type": "module",
  "description": "Build performant 3D user interfaces with Three.js and yoga.",
  "version": "1.0.76-dli.0",
  "sideEffects": false,
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/pmndrs/uikit",
  "author": "Bela Bohlender",
  "keywords": [
    "uikit",
    "three.js",
    "userinterface",
    "flexbox",
    "yoga",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dli7319/uikit.git"
  },
  "files": [
    "dist"
  ],
  "main": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./webgpu": {
      "import": "./src/webgpu/index.ts",
      "types": "./dist/webgpu/index.d.ts",
      "default": "./src/webgpu/index.ts"
    }
  },
  "publishConfig": {
    "main": "dist/index.js",
    "exports": {
      ".": "./dist/index.js",
      "./webgpu": "./dist/webgpu/index.js"
    }
  },
  "scripts": {
    "test": "mocha ./tests/*.spec.ts",
    "test:dts": "mocha ./tests/dts.spec.ts",
    "build": "node scripts/build-msdf-assets.mjs && tsc -p ./tsconfig.build.json",
    "generate": "node --loader ts-node/esm scripts/flex-generate-setter.ts",
    "check:prettier": "prettier --check src scripts tests",
    "check:eslint": "eslint 'src/**/*.{tsx,ts}'",
    "fix:prettier": "prettier --write src scripts tests",
    "fix:eslint": "eslint 'src/**/*.{tsx,ts}' --fix",
    "prepare": "node scripts/build-msdf-assets.mjs"
  },
  "peerDependencies": {
    "three": ">=0.162"
  },
  "dependencies": {
    "@pmndrs/msdfonts": "^1.0.76",
    "@pmndrs/uikit-pub-sub": "^1.0.76",
    "@preact/signals-core": "^1.5.1",
    "@zappar/msdf-generator": "^1.2.4",
    "yoga-layout": "^3.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.21.5"
  }
}
